    "@types/three": "^0.183.1",
    "framer-motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.183.2",
    "tsparticles": "^3.9.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.1.0",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.5.2",
    "lucide-react": "^0.400.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
