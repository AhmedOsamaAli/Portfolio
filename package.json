{
  "name": "ahmed-osama-portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:ui && npm run test:sync",
    "test:ui": "vitest run src",
    "test:sync": "node --test scripts/content-sync.test.mjs",
    "typecheck": "tsc --noEmit",
    "ci": "npm run test && npm run typecheck && vite build",
    "sync": "node scripts/content-sync.mjs",
    "sync:inspect": "node scripts/content-sync.mjs --inspect",
    "ai:setup": "node scripts/setup-local-ai.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tsparticles/react": "^3.0.0",
